# url-management-service base URL (auth + URL CRUD)
VITE_API_BASE=http://localhost:3001

# The domain shown to users as the short link base.
# In production: set this to your Vercel domain (or custom domain).
# Vercel proxies /:shortCode → redirect-service internally.
# In local dev: set this to the redirect-service directly (e.g. http://localhost:3002)
VITE_SHORT_URL_BASE=http://localhost:3002
