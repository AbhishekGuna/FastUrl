PORT=3000
DATABASE_URL=postgres://fasturl:fasturl@localhost:5434/fasturl
REDIS_URL=redis://localhost:6380
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
SHORT_URL_BASE=http://localhost:3000
CORS_ORIGINS=http://localhost:8080
# SendGrid API key, used for OTP / password-reset and notification emails.
# Create at https://app.sendgrid.com/settings/api_keys — starts with "SG.".
SENDGRID_API_KEY=SG.key

# "From" address for outbound mail. Must be a verified sender or belong to a
# verified domain in SendGrid, otherwise sends are rejected.
SENDGRID_FROM_EMAIL=email@example.com
EMAIL_FROM_NAME=FastUrl-auth